model LeaveType {
  id                  String        @id @default(cuid())
  tenantId            String
  name                String
  category            LeaveCategory
  accrualRateMinutes  Int           @default(0) // minutes accrued per pay period
  maxBalanceMinutes   Int?          // null = no cap
  requiresApproval    Boolean       @default(true)
  isPaid              Boolean       @default(true)
  externalCode        Int?          // numeric code for REST API identification
  accrualTracked      Boolean       @default(true)
  isActive            Boolean       @default(true)
  payCodeId           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  payCode       PayCode?            @relation(fields: [payCodeId], references: [id])
  balances      LeaveBalance[]
  requests      LeaveRequest[]
  accrualLedger LeaveAccrualLedger[]
  ptoPolicyRules      PtoPolicyRule[]
  ptoPolicies         PtoPolicy[]
  sitePtoPolicies     SitePtoPolicy[]
  payCategoryLinks    PayCategoryLeaveType[]

  @@unique([tenantId, externalCode])
  @@map("leave_types")
}

model LeaveBalance {
  id                  String   @id @default(cuid())
  employeeId          String
  leaveTypeId         String
  balanceMinutes      Int      @default(0)
  usedMinutes         Int      @default(0)
  accrualYear         Int
  updatedAt           DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, accrualYear])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String             @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  status       LeaveRequestStatus @default(DRAFT)
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  durationMinutes Int
  selectedDays Json?              /// [{ date: "YYYY-MM-DD", type: "FULL" | "PARTIAL", leaveFrom?: "HH:mm" }]
  note         String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?
  postedAt     DateTime?
  cancelledAt   DateTime?
  sourcePunchId String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  employee      Employee   @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType  @relation(fields: [leaveTypeId], references: [id])
  sourcePunch   Punch?     @relation("SourcePunchLeaveRequest", fields: [sourcePunchId], references: [id])
  ledgerEntries LeaveAccrualLedger[]
  segments      WorkSegment[]

  @@map("leave_requests")
}

/// Immutable ledger — append-only, never UPDATE or DELETE.
model LeaveAccrualLedger {
  id             String        @id @default(cuid())
  employeeId     String
  leaveTypeId    String
  action         AccrualAction
  deltaMinutes   Int           // positive = credit, negative = debit
  balanceAfter   Int
  leaveRequestId String?
  payPeriodEnd   DateTime?     @db.Date
  note           String?
  createdAt      DateTime      @default(now())
  createdById    String?

  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id])

  @@map("leave_accrual_ledger")
}

model Holiday {
  id                    String    @id @default(cuid())
  tenantId              String
  name                  String
  date                  DateTime  // stored as UTC midnight
  observedDate          DateTime? // optional observed date (e.g. Monday when holiday falls on Sunday)
  bypassAfterEligibility Boolean  @default(false)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  holidayRules HolidayRuleHoliday[]

  @@unique([tenantId, date])
  @@map("holidays")
}
