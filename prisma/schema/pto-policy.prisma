model PtoPolicy {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                      @relation(fields: [tenantId], references: [id])
  rules        PtoPolicyRule[]
  siteLinks    SitePtoPolicy[]
  empOverrides EmployeePtoPolicyOverride[]

  @@unique([tenantId, name])
  @@map("pto_policies")
}

// One row per leave type + tenure tier covered by this policy.
// A leave type with no tiers is simply absent from this table.
model PtoPolicyRule {
  id              String  @id @default(cuid())
  ptoPolicyId     String
  leaveTypeId     String
  minTenureMonths Int     @default(0)                    // inclusive lower bound (0 = from hire)
  maxTenureMonths Int?                                   // exclusive upper bound; null = open-ended top tier
  annualHours        Int     @default(0)                 // base yearly PTO entitlement for this tier
  earnedHoursPerYear Int     @default(0)                 // additional hours earned per complete year of tenure (0 = no longevity bonus)
  carryOverHours     Int?                                // null = unlimited carry-over

  ptoPolicy PtoPolicy @relation(fields: [ptoPolicyId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([ptoPolicyId, leaveTypeId, minTenureMonths])
  @@map("pto_policy_rules")
}

// Site's default policy per leave type
model SitePtoPolicy {
  id          String @id @default(cuid())
  siteId      String
  leaveTypeId String
  ptoPolicyId String

  site      Site      @relation(fields: [siteId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  ptoPolicy PtoPolicy @relation(fields: [ptoPolicyId], references: [id])

  @@unique([siteId, leaveTypeId])
  @@map("site_pto_policies")
}

// Per-employee override (supersedes site default for all leave types)
model EmployeePtoPolicyOverride {
  id          String @id @default(cuid())
  employeeId  String @unique
  ptoPolicyId String

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ptoPolicy PtoPolicy @relation(fields: [ptoPolicyId], references: [id])

  @@map("employee_pto_policy_overrides")
}
