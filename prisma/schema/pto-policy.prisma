enum AccrualPostingFreq {
  PER_PAY_PERIOD
  DAILY
  WEEKLY
  BI_WEEKLY
  SEMI_MONTHLY
  MONTHLY
  EVERY_2_MONTHS
  QUARTERLY
  EVERY_4_MONTHS
  SEMI_ANNUALLY
  ANNUALLY
  ANNUALLY_HIRE
  ANNUALLY_FIXED
}

enum AccrualRateMode {
  YEARLY
  PER_POSTING
}

enum ServiceMonthBasis {
  HIRE_DATE
  ADJUSTED_HIRE_DATE
  TITLE_CHANGE_DATE
  ORIENTATION_DATE
  USER_DATE_2
}

model PtoPolicy {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)

  rateMode           AccrualRateMode     @default(YEARLY)
  serviceMonthBasis  ServiceMonthBasis   @default(HIRE_DATE)

  posting1Freq  AccrualPostingFreq  @default(PER_PAY_PERIOD)
  posting1Month Int?
  posting1Day   Int?
  dualPosting              Boolean             @default(false)
  posting2Freq             AccrualPostingFreq?
  posting2Month            Int?
  posting2Day              Int?
  posting2ServiceMonthBasis ServiceMonthBasis? // null = same as posting1
  posting2AnchorDate       DateTime? @db.Date
  posting2StartsOnYear     Int?      // "starts on the Nth calendar year"; null = immediately
  posting2BasedOnMonths    Boolean   @default(false) // when true, posting2StartsOnYear is in months

  postingAnchorDate DateTime? @db.Date  // reference date for fixed-cycle frequencies (e.g. bi-weekly)

  balanceReset Boolean @default(false)
  resetMonth   Int?    // 1–12: month on which the annual reset fires
  resetDay     Int?    // 1–31: day of the month on which the annual reset fires

  leaveTypeId String?  // single leave type this policy covers (null = legacy multi-type)
  leaveType   LeaveType? @relation(fields: [leaveTypeId], references: [id])

  maxDailyHours        Float?   // null = no per-day cap on leave requests
  allowNegativeBalance Boolean  @default(false)
  maxNegativeHours     Float?   // null = unlimited borrow when allowNegativeBalance is true
  carryOverEnabled           Boolean @default(true)  // when false, no carry-over posts at balance reset
  carryOverRespectMaxBalance Boolean @default(false) // when true, cross-bucket carry-over won't exceed destination's max balance

  forecastEnabled          Boolean @default(false) // when true, compute projected future accruals
  forecastMode             String? // "MONTHS" | "END_OF_YEAR"
  forecastMonths           Int?    // number of months ahead (only when forecastMode = "MONTHS")
  forecastApplyToAvailable Boolean @default(false) // when true, available balance includes forecasted hours

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant                      @relation(fields: [tenantId], references: [id])
  rules         PtoPolicyRule[]
  siteLinks     SitePtoPolicy[]
  categoryLinks PayCategoryPtoPolicy[]

  @@unique([tenantId, name])
  @@map("pto_policies")
}

// One row per leave type + tenure tier covered by this policy.
// A leave type with no tiers is simply absent from this table.
model PtoPolicyRule {
  id              String  @id @default(cuid())
  ptoPolicyId     String
  leaveTypeId     String
  minTenureMonths Int     @default(0)                    // inclusive lower bound (0 = from hire)
  maxTenureMonths Int?                                   // exclusive upper bound; null = open-ended top tier
  annualHours        Float   @default(0)                 // yearly entitlement (YEARLY mode) or per-posting rate (PER_POSTING mode)
  earnedHoursPerYear Float   @default(0)                 // additional hours per year of tenure (0 = no longevity bonus)
  carryOverHours          Int?                           // null = unlimited carry-over
  carryOverToLeaveTypeId  String?                        // null = carry over into same leave type
  maxAnnualHours          Float?                         // null = no annual usage cap
  maxBalanceHours         Float?                         // null = fall back to LeaveType.maxBalanceMinutes
  payCodeId               String?                        // optional pay code override for this rule

  ptoPolicy PtoPolicy  @relation(fields: [ptoPolicyId], references: [id], onDelete: Cascade)
  leaveType LeaveType  @relation(fields: [leaveTypeId], references: [id])
  payCode   PayCode?   @relation(fields: [payCodeId], references: [id])

  @@unique([ptoPolicyId, leaveTypeId, minTenureMonths])
  @@map("pto_policy_rules")
}

// Site's default policy per leave type
model SitePtoPolicy {
  id          String @id @default(cuid())
  siteId      String
  leaveTypeId String
  ptoPolicyId String

  site      Site      @relation(fields: [siteId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  ptoPolicy PtoPolicy @relation(fields: [ptoPolicyId], references: [id])

  @@unique([siteId, leaveTypeId])
  @@map("site_pto_policies")
}

