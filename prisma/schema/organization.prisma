model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)

  // Pay period configuration
  payFrequency        PayFrequency @default(BIWEEKLY)
  payPeriodAnchorDate DateTime?    // A known pay-period start date; all periods calculated from this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites       Site[]
  departments Department[]
  employees   Employee[]
  ruleSets    RuleSet[]
  payPeriods  PayPeriod[]
  leaveTypes  LeaveType[]
  auditLogs   AuditLog[]
  reports     ReportDefinition[]
  customRoles CustomRole[]
  ptoPolicies PtoPolicy[]
  payCodes    PayCode[]
  reasonCodes ReasonCode[]
  holidays     Holiday[]
  shifts       Shift[]
  holidayRules   HolidayRule[]
  payCategories  PayCategory[]
  payTypes       PayType[]
  apiKeys        ApiKey[]
  syncRuns         SyncRun[]
  rosterCandidates RosterCandidate[]
  scheduleDays     ScheduleDay[]
  bridgeJobs       BridgeJob[]

  @@map("tenants")
}

model Site {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  timezone  String   @default("America/New_York")
  address   String?
  isActive  Boolean  @default(true)
  /// Whether a time clock here may refuse a punch from somebody with no recent
  /// gate scan. Off by default and set per site by hand: a building whose gate
  /// does not report to CloudTime must never have punches refused for want of
  /// one, and inferring this from traffic gets that exactly backwards.
  requireGateScan Boolean @default(false)

  /// Oracle's warehouse id for this building, from the legacy WarehouseLocation
  /// enum (NJ3 = 5, CAN = 8, NL = 9, CA2 = 10, NJ299 = 13, PA1055 = 15,
  /// CAN36 = 18, GA7575 = 19).
  ///
  /// <p>This is the link that lets an Oracle employee be placed in a building.
  /// Without it the roster sync knows a person exists, what department they are
  /// in and what their badge is, but not where they work — and site is one of
  /// the four things an Employee cannot be created without, which is why every
  /// staged RosterCandidate has had a null siteName.
  ///
  /// <p>Null where nobody has confirmed which warehouse a site is. Left null
  /// deliberately rather than guessed: the two Canadian buildings both map to
  /// plausible ids and putting somebody in the wrong building is worse than
  /// leaving the queue exactly as useful as it is today.
  wmsWarehouseId Int? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  departments DepartmentSite[]
  employees   Employee[]
  ptoPolicies SitePtoPolicy[]
  hrAccess    HrSiteAccess[]

  @@unique([tenantId, name])
  @@map("sites")
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  sites     DepartmentSite[]
  employees Employee[]

  @@map("departments")
}

model DepartmentSite {
  departmentId String
  siteId       String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([departmentId, siteId])
  @@map("department_sites")
}

model Employee {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String   @unique
  employeeCode String
  adpWorkerId  String?  @unique  /// ADP Workforce Now worker ID for sync
  wmsId        String?  @unique  /// Warehouse Management System badge ID (QR code)

  /// The value physically encoded on the badge, when it differs from wmsId.
  ///
  /// Two badge formats are in circulation: a 6-digit employee number (wmsId)
  /// and a 10-digit barcode. The legacy API resolves the second to the first
  /// via wmsusers.barcode -> framewrk.users.empid; this system had no such
  /// step, so every 10-digit badge failed to match and its punches were never
  /// recorded at all. Kiosk lookups now accept either.
  barcode         String?   @unique
  /// True when someone set the barcode by hand. The Oracle sync leaves these
  /// alone, so a deliberate correction is not silently overwritten overnight.
  barcodeOverride Boolean   @default(false)
  /// When the Oracle sync last confirmed this barcode.
  barcodeSyncedAt DateTime?
  role         Role     @default(EMPLOYEE)
  customRoleId String?
  supervisorId String?
  siteId       String
  departmentId String
  ruleSetId    String
  shiftId      String?
  isActive     Boolean  @default(true)
  onLeave      Boolean  @default(false)
  hireDate         DateTime
  adjustedHireDate DateTime?  /// Seniority date override — used when serviceMonthBasis = ADJUSTED_HIRE_DATE
  titleChangeDate  DateTime?  /// Date of last title/role change
  orientationDate  DateTime?  /// Orientation / training completion date
  userDate2        DateTime?  /// Custom configurable date field
  dateOfBirth      DateTime?
  terminatedAt     DateTime?

  // Work info
  jobTitle          String?
  terminationReason String?

  // Pay
  payType        String?          // "HOURLY" | "SALARY" — compensation method
  payTypeId      String?          // FK → PayType (FLSA classification)
  payRate        Decimal?  @db.Decimal(10, 4)
  holidayRuleId  String?
  payCategoryId  String?

  // Personal
  phone         String?
  phone2        String?
  gender        String?
  maritalStatus String?

  // Emergency contact
  emergencyContact      String?
  emergencyPhone        String?
  emergencyRelationship String?

  // Address
  address1 String?
  address2 String?
  city     String?
  state    String?
  country  String?
  zipCode  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id])
  supervisor   Employee?    @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates Employee[]   @relation("EmployeeSupervisor")
  site         Site         @relation(fields: [siteId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  ruleSet      RuleSet      @relation(fields: [ruleSetId], references: [id])
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  holidayRule  HolidayRule? @relation(fields: [holidayRuleId], references: [id])
  payCategory  PayCategory? @relation(fields: [payCategoryId], references: [id])
  payTypeLookup PayType?    @relation(fields: [payTypeId], references: [id])
  punches      Punch[]
  scanEvents   ScanEvent[]
  scheduleDays ScheduleDay[]
  timesheets   Timesheet[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  documents        Document[]
  auditLogs        AuditLog[]
  mealWaiversCreated MealWaiver[]
  badges             EmployeeBadge[]
  legacySyncLogs     LegacySyncLog[]
  siteAccess         HrSiteAccess[]

  @@unique([tenantId, employeeCode])
  @@map("employees")
}

/// Every card a person can physically present, not just the last one Oracle
/// mentioned.
///
/// <p>Oracle's `wmsusers` holds one row per card, so an employee who was
/// re-issued a badge keeps the old row alongside the new one — 95 employee
/// numbers in the 2026-09-21 export carry between two and four barcodes each.
/// `Employee.barcode` is a single unique column, so the sync could only ever
/// keep one of them and the rest resolved to nobody. Measured the same day:
/// ten of those people are active, four of their spare cards were in daily use,
/// and 41 scans over 14 days were recorded against no employee because of it.
///
/// <p>That cost nothing while Oracle was still the one answering "is this a
/// valid badge", because Oracle recognised every card. It becomes a lockout the
/// moment CloudTime is the only system deciding — which is the direction this
/// is moving — so the alias has to exist before the decision does.
///
/// <p>`Employee.barcode` is left in place and still resolves. This table is
/// additive: it carries the cards that column has no room for.
model EmployeeBadge {
  id         String      @id @default(cuid())
  employeeId String
  /// The barcode exactly as Oracle stores it — unpadded. The tablets zero-pad
  /// to ten characters, and that difference is reconciled when comparing, not
  /// by rewriting what the source system said. See badge-lookup.
  barcode    String      @unique
  source     BadgeSource @default(ORACLE)
  /// When the Oracle sync last saw this card in the feed. Null on a card a
  /// person entered by hand, which Oracle may never have heard of.
  syncedAt   DateTime?
  createdAt  DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_badges")
}

model HrSiteAccess {
  id         String   @id @default(cuid())
  employeeId String
  siteId     String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([employeeId, siteId])
  @@map("hr_site_access")
}

enum ShiftCycle {
  WEEKLY
  CUSTOM
}

enum ShiftType {
  FIXED
  FLEXIBLE
  DYNAMIC
}

model Shift {
  id        String   @id @default(cuid())
  tenantId  String
  number    Int?     /// Optional shift number for display / sorting
  name      String
  startTime String   /// Time of day in HH:mm format, e.g. "06:00"
  endTime   String   /// Time of day in HH:mm format, e.g. "14:00"
  workDays  Int[]    @default(dbgenerated("ARRAY[1,2,3,4,5]::integer[]")) /// 0=Sun 1=Mon … 6=Sat

  // Employee setup visibility
  excludeFromSetup Boolean @default(false) /// When true, shift is hidden from the employee assignment list

  // Shift cycle (for rotating / custom schedules)
  shiftCycle          ShiftCycle @default(WEEKLY)
  cycleDays           Int        @default(7)     /// Number of days in the custom cycle (used when shiftCycle = CUSTOM)
  cycleReferenceDate  DateTime?                  /// Anchor date for cycle alignment (used when shiftCycle = CUSTOM)

  // Shift type
  shiftType                  ShiftType @default(FIXED)
  useScheduleGroupQualifiers Boolean   @default(false) /// Dynamic only: filter schedule entries by group qualifiers

  // Scheduling metrics
  averageHours Decimal? @db.Decimal(5, 2) /// Expected average daily hours (informational, used by scheduler)

  /// Per-day schedule: JSON array of 7 DayScheduleRow objects (Sun–Sat).
  /// Each row: { day, isWorkday, dayStart, dayEnd, startTime, endTime, mealMinutes }
  daySchedule Json?

  /// Meal deduction rules (Novatime-style). See MealConfig type in shift.actions.ts.
  mealConfig Json?

  /// Paid rest break rules. See BreakConfig type in shift.actions.ts.
  breakConfig Json?

  /// Pay differential rules. See DifferentialConfig type in shift.actions.ts.
  differentialConfig Json?

  // Scheduled meal break (legacy / Break-tab override)
  mealBreakStart String? /// HH:mm — scheduled break start time
  mealBreakEnd   String? /// HH:mm — scheduled break end time

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]
  scheduleDays ScheduleDay[]

  @@unique([tenantId, name])
  @@map("shifts")
}

model Document {
  id          String   @id @default(cuid())
  employeeId  String
  title       String
  fileUrl     String
  fileType    String
  uploadedAt  DateTime @default(now())
  uploadedBy  String

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("documents")
}
