model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)

  // Pay period configuration
  payFrequency        PayFrequency @default(BIWEEKLY)
  payPeriodAnchorDate DateTime?    // A known pay-period start date; all periods calculated from this

  /// Retired: the company wide gate alert switch, replaced by one per building
  /// (Site.gateAlertsOnSince). Nothing reads it now. Kept so a deploy cannot
  /// land between the migration and the code that reads the new column.
  gateAlertsOnSince DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites       Site[]
  departments Department[]
  employees   Employee[]
  ruleSets    RuleSet[]
  payPeriods  PayPeriod[]
  leaveTypes  LeaveType[]
  auditLogs   AuditLog[]
  reports     ReportDefinition[]
  customRoles CustomRole[]
  ptoPolicies PtoPolicy[]
  payCodes    PayCode[]
  reasonCodes ReasonCode[]
  holidays     Holiday[]
  shifts       Shift[]
  holidayRules   HolidayRule[]
  payCategories  PayCategory[]
  payTypes       PayType[]
  jobTitles      JobTitle[]
  agencies       Agency[]
  apiKeys        ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  syncRuns         SyncRun[]
  rosterCandidates RosterCandidate[]
  scheduleDays     ScheduleDay[]
  bridgeJobs       BridgeJob[]

  @@map("tenants")
}

model Site {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  timezone  String   @default("America/New_York")
  address   String?
  isActive  Boolean  @default(true)
  /// Whether a time clock here may refuse a punch from somebody with no recent
  /// gate scan. Off by default and set per site by hand: a building whose gate
  /// does not report to CloudTime must never have punches refused for want of
  /// one, and inferring this from traffic gets that exactly backwards.
  requireGateScan Boolean @default(false)

  /// How this site applies the security-first rule. Supersedes
  /// requireGateScan, which is kept only so a deploy cannot land between the
  /// migration and the code that reads the new column; nothing reads it now.
  gateScanMode GateScanMode @default(OFF)

  /// Oracle's warehouse id for this building, from the legacy WarehouseLocation
  /// enum (NJ3 = 5, CAN = 8, NL = 9, CA2 = 10, NJ299 = 13, PA1055 = 15,
  /// CAN36 = 18, GA7575 = 19).
  ///
  /// <p>This is the link that lets an Oracle employee be placed in a building.
  /// Without it the roster sync knows a person exists, what department they are
  /// in and what their badge is, but not where they work — and site is one of
  /// the four things an Employee cannot be created without, which is why every
  /// staged RosterCandidate has had a null siteName.
  ///
  /// <p>Null where nobody has confirmed which warehouse a site is. Left null
  /// deliberately rather than guessed: the two Canadian buildings both map to
  /// plausible ids and putting somebody in the wrong building is worse than
  /// leaving the queue exactly as useful as it is today.
  wmsWarehouseId Int? @unique
  /// When the Live Attendance gate alert was last turned on in this building,
  /// or null while it is off. A System Admin switches it in the Live
  /// Attendance header, one building at a time, so it can run where the gate
  /// tablets say which building they are in and stay off where they do not
  /// yet. A time rather than a flag, so turning it back on shows only people
  /// turned away since then, never a morning's worth at once. Refusals are
  /// recorded either way. Starts off (no default).
  gateAlertsOnSince DateTime?
  /// The language the building mostly works in, and the others spoken there,
  /// as language codes (lib/languages.ts, "es"). Informational for now.
  primaryLanguage     String?
  additionalLanguages String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  departments DepartmentSite[]
  employees   Employee[]
  ptoPolicies SitePtoPolicy[]
  hrAccess    HrSiteAccess[]
  gateRefusals GateRefusal[]
  devices     Device[]

  @@unique([tenantId, name])
  @@map("sites")
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  sites     DepartmentSite[]
  employees Employee[]

  @@map("departments")
}

model DepartmentSite {
  departmentId String
  siteId       String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([departmentId, siteId])
  @@map("department_sites")
}

model Employee {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String   @unique
  employeeCode String
  adpWorkerId  String?  @unique  /// ADP Workforce Now worker ID for sync
  wmsId        String?  @unique  /// Warehouse Management System badge ID (QR code)
  /// The name WMS (Oracle) holds for this person, kept current by the roster
  /// sync. Shown on the tablets and in Live Attendance, where people know each
  /// other by it. Never the person's name of record: that is users.name, the
  /// legal name from ADP and HR, which the sync never writes. Null until the
  /// sync has seen them; anything showing it falls back to the legal name.
  wmsName      String?
  /// Whether WMS (Oracle) still employs this person, as of the last roster
  /// sync. Kept beside isActive, never copied into it: the time clock, the
  /// timecards and payroll go by isActive alone. Only the gate reads this, to
  /// turn away someone WMS has terminated (src/lib/presence/employment.ts).
  /// Null until the sync has seen them, which counts as employed.
  wmsActive    Boolean?

  /// The value physically encoded on the badge, when it differs from wmsId.
  ///
  /// Two badge formats are in circulation: a 6-digit employee number (wmsId)
  /// and a 10-digit barcode. The legacy API resolves the second to the first
  /// via wmsusers.barcode -> framewrk.users.empid; this system had no such
  /// step, so every 10-digit badge failed to match and its punches were never
  /// recorded at all. Kiosk lookups now accept either.
  barcode         String?   @unique
  /// True when someone set the barcode by hand. The Oracle sync leaves these
  /// alone, so a deliberate correction is not silently overwritten overnight.
  barcodeOverride Boolean   @default(false)
  /// When the Oracle sync last confirmed this barcode.
  barcodeSyncedAt DateTime?
  role         Role     @default(EMPLOYEE)
  customRoleId String?
  supervisorId String?
  siteId       String
  departmentId String
  ruleSetId    String
  shiftId      String?
  isActive     Boolean  @default(true)
  onLeave      Boolean  @default(false)
  /// May punch from the Punch Clock page (and the phone app). Off, the time
  /// clock tablets are the only way in; missed punch requests still work.
  webPunchEnabled Boolean @default(false)
  hireDate         DateTime
  adjustedHireDate DateTime?  /// Seniority date override — used when serviceMonthBasis = ADJUSTED_HIRE_DATE
  titleChangeDate  DateTime?  /// Date of last title/role change
  orientationDate  DateTime?  /// Orientation / training completion date
  userDate2        DateTime?  /// Custom configurable date field
  dateOfBirth      DateTime?
  terminatedAt     DateTime?
  /// The person's own time zone (IANA, e.g. "America/Los_Angeles"), for someone
  /// who works in another zone than their site, such as a Rey 11 person in
  /// California. Null means the site's zone, which is everyone else.
  timeZone         String?
  /// The language the person prefers, as a language code (lib/languages.ts).
  /// Informational for now.
  preferredLanguage String?

  // Work info
  jobTitle          String?
  jobTitleId        String?
  jobTitleRef       JobTitle? @relation(fields: [jobTitleId], references: [id])
  agencyId          String?
  agencyRef         Agency?   @relation(fields: [agencyId], references: [id])
  terminationReason String?

  // Pay
  payType        String?          // "HOURLY" | "SALARY" — compensation method
  payTypeId      String?          // FK → PayType (FLSA classification)
  payRate        Decimal?  @db.Decimal(10, 4)
  /// Informational only, as NovaTime's Miscellaneous Rate: nothing calculates with these.
  chargeRate     Decimal?  @db.Decimal(10, 4)
  holidayRate    Decimal?  @db.Decimal(10, 4)
  overtimeRate   Decimal?  @db.Decimal(10, 4)
  holidayRuleId  String?
  payCategoryId  String?

  // Personal
  phone         String?
  phone2        String?
  gender        String?
  maritalStatus String?

  // Emergency contact
  emergencyContact      String?
  emergencyPhone        String?
  emergencyRelationship String?

  // Address
  address1 String?
  address2 String?
  city     String?
  state    String?
  country  String?
  zipCode  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id])
  supervisor   Employee?    @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  subordinates Employee[]   @relation("EmployeeSupervisor")
  // Supervisors besides the one above (an agency's viewer beside the
  // warehouse supervisor). They see the person as their own; what they may
  // do comes from their role. The one above stays the supervisor of record.
  additionalSupervisors EmployeeSupervisor[] @relation("SupervisedEmployee")
  alsoSupervises        EmployeeSupervisor[] @relation("AdditionalSupervisor")
  site         Site         @relation(fields: [siteId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])
  ruleSet      RuleSet      @relation(fields: [ruleSetId], references: [id])
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  holidayRule  HolidayRule? @relation(fields: [holidayRuleId], references: [id])
  payCategory  PayCategory? @relation(fields: [payCategoryId], references: [id])
  payTypeLookup PayType?    @relation(fields: [payTypeId], references: [id])
  punches      Punch[]
  scanEvents   ScanEvent[]
  scheduleDays ScheduleDay[]
  gateRefusals GateRefusal[]
  timesheets   Timesheet[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  documents        Document[]
  auditLogs        AuditLog[]
  mealWaiversCreated        MealWaiver[]
  mealPremiumWaiversCreated MealPremiumWaiver[]
  badges             EmployeeBadge[]
  legacySyncLogs     LegacySyncLog[]
  siteAccess         HrSiteAccess[]
  ruleSetHistory     EmployeeRuleSetHistory[]
  ruleSetHistoryCreated EmployeeRuleSetHistory[] @relation("RuleSetHistoryCreator")
  payRates           EmployeePayRate[]

  @@unique([tenantId, employeeCode])
  // The roster, the team scopes and the admin filters. Every one of these
  // was a full scan of 7,420 rows.
  @@index([tenantId, isActive])
  @@index([supervisorId])
  @@index([siteId])
  @@index([departmentId])
  @@index([ruleSetId])
  @@map("employees")
}

/// Every card a person can physically present, not just the last one Oracle
/// mentioned.
///
/// <p>Oracle's `wmsusers` holds one row per card, so an employee who was
/// re-issued a badge keeps the old row alongside the new one — 95 employee
/// numbers in the 2026-09-21 export carry between two and four barcodes each.
/// `Employee.barcode` is a single unique column, so the sync could only ever
/// keep one of them and the rest resolved to nobody. Measured the same day:
/// ten of those people are active, four of their spare cards were in daily use,
/// and 41 scans over 14 days were recorded against no employee because of it.
///
/// <p>That cost nothing while Oracle was still the one answering "is this a
/// valid badge", because Oracle recognised every card. It becomes a lockout the
/// moment CloudTime is the only system deciding — which is the direction this
/// is moving — so the alias has to exist before the decision does.
///
/// <p>`Employee.barcode` is left in place and still resolves. This table is
/// additive: it carries the cards that column has no room for.
model EmployeeBadge {
  id         String      @id @default(cuid())
  employeeId String
  /// The barcode exactly as Oracle stores it — unpadded. The tablets zero-pad
  /// to ten characters, and that difference is reconciled when comparing, not
  /// by rewriting what the source system said. See badge-lookup.
  barcode    String      @unique
  source     BadgeSource @default(ORACLE)
  /// When the Oracle sync last saw this card in the feed. Null on a card a
  /// person entered by hand, which Oracle may never have heard of.
  syncedAt   DateTime?
  createdAt  DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_badges")
}

model HrSiteAccess {
  id         String   @id @default(cuid())
  employeeId String
  siteId     String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([employeeId, siteId])
  @@map("hr_site_access")
}

enum ShiftCycle {
  WEEKLY
  CUSTOM
}

enum ShiftType {
  FIXED
  FLEXIBLE
  DYNAMIC
}

model Shift {
  id        String   @id @default(cuid())
  tenantId  String
  number    Int?     /// Optional shift number for display / sorting
  name      String
  startTime String   /// Time of day in HH:mm format, e.g. "06:00"
  endTime   String   /// Time of day in HH:mm format, e.g. "14:00"
  workDays  Int[]    @default(dbgenerated("ARRAY[1,2,3,4,5]::integer[]")) /// 0=Sun 1=Mon … 6=Sat

  // Employee setup visibility
  excludeFromSetup Boolean @default(false) /// When true, shift is hidden from the employee assignment list

  // Shift cycle (for rotating / custom schedules)
  shiftCycle          ShiftCycle @default(WEEKLY)
  cycleDays           Int        @default(7)     /// Number of days in the custom cycle (used when shiftCycle = CUSTOM)
  cycleReferenceDate  DateTime?                  /// Anchor date for cycle alignment (used when shiftCycle = CUSTOM)

  // Shift type
  shiftType                  ShiftType @default(FIXED)
  useScheduleGroupQualifiers Boolean   @default(false) /// Dynamic only: filter schedule entries by group qualifiers

  // Scheduling metrics
  averageHours Decimal? @db.Decimal(5, 2) /// Expected average daily hours (informational, used by scheduler)

  /// Per-day schedule: JSON array of 7 DayScheduleRow objects (Sun–Sat).
  /// Each row: { day, isWorkday, dayStart, dayEnd, startTime, endTime, mealMinutes }
  daySchedule Json?

  /// Meal deduction rules (Novatime-style). See MealConfig type in shift.actions.ts.
  mealConfig Json?

  /// Paid rest break rules. See BreakConfig type in shift.actions.ts.
  breakConfig Json?

  /// Pay differential rules. See DifferentialConfig type in shift.actions.ts.
  differentialConfig Json?

  // Scheduled meal break (legacy / Break-tab override)
  mealBreakStart String? /// HH:mm — scheduled break start time
  mealBreakEnd   String? /// HH:mm — scheduled break end time

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]
  scheduleDays ScheduleDay[]

  @@unique([tenantId, name])
  @@map("shifts")
}

model Document {
  id          String   @id @default(cuid())
  employeeId  String
  title       String
  fileUrl     String
  fileType    String
  uploadedAt  DateTime @default(now())
  uploadedBy  String

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("documents")
}

/// A supervisor of an employee besides their supervisor of record.
model EmployeeSupervisor {
  id           String   @id @default(cuid())
  employeeId   String
  supervisorId String
  createdAt    DateTime @default(now())
  createdById  String?

  employee   Employee @relation("SupervisedEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  supervisor Employee @relation("AdditionalSupervisor", fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([employeeId, supervisorId])
  // The team scopes look these up by supervisor.
  @@index([supervisorId])
  @@map("employee_supervisors")
}

model EmployeeRuleSetHistory {
  id            String   @id @default(cuid())
  employeeId    String
  ruleSetId     String
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())
  createdById   String?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  ruleSet   RuleSet   @relation(fields: [ruleSetId], references: [id])
  createdBy Employee? @relation("RuleSetHistoryCreator", fields: [createdById], references: [id])

  @@index([employeeId, effectiveDate])
  @@map("employee_ruleset_history")
}

/// An employee's pay rates from an effective date, as NovaTime's Pay Rates
/// table. Rate 1 is the pay rate (Employee.payRate mirrors the one in effect
/// today); Rate 2 and Rate 3 are kept for reference only.
model EmployeePayRate {
  id            String   @id @default(cuid())
  employeeId    String
  effectiveDate DateTime @db.Date
  rate1         Decimal  @db.Decimal(10, 4)
  rate2         Decimal? @db.Decimal(10, 4)
  rate3         Decimal? @db.Decimal(10, 4)
  /// The markup on Rate 1 in percent (32 = 32%), and the charge rate it gives:
  /// Rate 1 × (1 + markup), to the cent, unless chargeManual says the charge
  /// rate was set by hand (an agreement that does not follow the formula).
  markupPct     Decimal? @db.Decimal(7, 3)
  chargeRate    Decimal? @db.Decimal(10, 4)
  chargeManual  Boolean  @default(false)
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveDate])
  @@map("employee_pay_rates")
}

model Agency {
  id          String   @id @default(cuid())
  tenantId    String
  code        Int                       // numeric agency code
  description String
  laborRate   Decimal  @default(0) @db.Decimal(10, 6)
  chargeRate  Decimal  @default(0) @db.Decimal(10, 6)
  /// The markup this agency's agreement adds to the hourly rate, in percent
  /// (32 = 32%). A new pay rate row for one of its people starts from it.
  defaultMarkupPct Decimal? @db.Decimal(7, 3)
  inactiveOn  DateTime?                 // null = still active
  maxWorkHours Decimal @default(0) @db.Decimal(8, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@index([tenantId])
  @@map("agencies")
}

model JobTitle {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  externalId String?  // configurable ID (e.g. ADP job code, position number)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@index([tenantId])
  @@map("job_titles")
}
