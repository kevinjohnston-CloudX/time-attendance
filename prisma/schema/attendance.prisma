model PayPeriod {
  id        String          @id @default(cuid())
  tenantId  String
  ruleSetId String?         // null = tenant-level (legacy/fallback); non-null = rule-set-specific schedule
  startDate DateTime
  endDate   DateTime
  status    PayPeriodStatus @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  ruleSet    RuleSet?    @relation(fields: [ruleSetId], references: [id])
  timesheets Timesheet[]
  payrollRun PayrollRun?

  // Uniqueness enforced at application level; indexes for query performance
  @@index([tenantId, startDate, endDate])
  @@index([ruleSetId, startDate, endDate])
  @@map("pay_periods")
}

model Timesheet {
  id           String          @id @default(cuid())
  employeeId   String
  payPeriodId  String
  status       TimesheetStatus @default(OPEN)
  submittedAt  DateTime?
  supApprovedAt    DateTime?
  supApprovedById  String?
  payrollApprovedAt   DateTime?
  payrollApprovedById String?
  lockedAt     DateTime?
  rejectedAt   DateTime?
  rejectedById String?
  rejectionNote String?
  otAuthorized Boolean @default(false) // true once a supervisor authorizes the OT hours
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id])
  payPeriod  PayPeriod  @relation(fields: [payPeriodId], references: [id])
  punches         Punch[]
  segments        WorkSegment[]
  exceptions      Exception[]
  overtimeBuckets OvertimeBucket[]
  mealWaivers     MealWaiver[]
  notes           TimesheetNote[]
  dayReasons      TimesheetDayReason[]

  @@unique([employeeId, payPeriodId])
  @@map("timesheets")
}

/// Immutable. Never UPDATE or DELETE. Corrections create linked records.
model Punch {
  id           String      @id @default(cuid())
  employeeId   String
  timesheetId  String?     // null for rejected punches that arrived before a pay period existed
  punchType    PunchType
  punchTime    DateTime
  roundedTime  DateTime
  source       PunchSource @default(WEB)
  stateBefore  PunchState
  stateAfter   PunchState
  isApproved   Boolean     @default(true)
  isRejected   Boolean     @default(false)
  rejectionReason String?
  approvedById String?
  approvedAt   DateTime?
  note         String?
  payCodeId    String?

  /// ID of the punch this record corrects (null if original)
  correctsId    String? @unique
  /// ID of the correction that supersedes this record (null if current)
  correctedById String?

  createdAt DateTime @default(now())

  employee    Employee    @relation(fields: [employeeId], references: [id])
  timesheet   Timesheet?  @relation(fields: [timesheetId], references: [id])
  corrects    Punch?      @relation("PunchCorrection", fields: [correctsId], references: [id])
  correctedBy Punch?      @relation("PunchCorrection")
  payCode     PayCode?    @relation("PunchPayCode", fields: [payCodeId], references: [id])
  sourcedLeaveRequest LeaveRequest? @relation("SourcePunchLeaveRequest")
  scanEvent   ScanEvent?

  @@map("punches")
}

/// The tablets' own transaction log: one row per scan a kiosk reports, from
/// both the Time Clock flow and the Security gate.
///
/// <b>This table is deliberately independent of the timecard pipeline.</b> It
/// records what a tablet did, not what the punch engine concluded, and it is
/// written BEFORE that engine runs. That independence is the whole point — a
/// witness that copies its testimony from the accused is worth nothing. It
/// means this table can show:
///   - a scan the pipeline refused (no pay period, locked timesheet, bad state)
///   - a scan whose badge matches no employee
///   - a scan the pipeline crashed on
///   - a scan whose direction disagrees with the punch that came of it
/// none of which leave any trace in `punches`, because in those cases no punch
/// exists to leave one.
///
/// `direction` is resolved by this table alone, by alternating from the
/// employee's previous scan in the same stream. It is never copied from the
/// punch engine. `timecardPunchType` / `timecardStateAfter` record what that
/// engine decided, so the two can be compared — which is exactly what
/// detect-scan-discrepancies does.
///
/// The two streams are tracked independently: someone can be inside the
/// building (SECURITY = IN) while clocked out for a meal (TIME_CLOCK = OUT),
/// so a single flag would be wrong for anyone on lunch.
///
/// Gate scans never become a Punch. A gate crossing is a building-access
/// event, not paid time, and routing it into the timecard pipeline would
/// double-count hours for anyone who badges a gate and then clocks in.
///
/// Scans can arrive out of order: a tablet that was offline flushes its queue
/// minutes or hours later. Direction is therefore resolved against the previous
/// event *by scan time*, not by arrival, and inserting a late scan re-resolves
/// the events that follow it. See scan-event.service.ts.
model ScanEvent {
  id         String        @id @default(cuid())
  /// Denormalised from the employee so a scan stays scoped even if unmatched.
  tenantId   String?
  employeeId String?
  /// The badge exactly as the QR decoded, kept even when no employee matches —
  /// an unmatched scan is precisely the one someone asks about later.
  badgeCode  String
  stream     ScanStream
  direction  ScanDirection @default(UNKNOWN)
  /// Whether `direction` was read off the source or guessed by alternation.
  /// Only ALTERNATION rows may be rewritten by `reresolveFollowing`.
  directionSource ScanDirectionSource @default(ALTERNATION)
  /// Instant of the scan, in UTC, converted from the kiosk's configured zone.
  scanTime   DateTime
  deviceName String?
  /// Which build of the kiosk app recorded this scan, as its versionName.
  ///
  /// Null for anything a tablet older than 154 sent, and for rows expanded from
  /// a legacy report. That null is itself the answer to "is this tablet still on
  /// the old build", which until now could only be established by walking up to
  /// it — the reason three separate questions today came down to guessing which
  /// build a given reader was running.
  appVersion String?
  /// Where the reader is. Text, not Int: the time clocks report NJ299 / NJ3 /
  /// CA2 / GA7575 / CAN while the gates report numeric location ids, and an
  /// integer column could only ever hold the gates.
  site       String?
  /// Superseded by `site`. Nothing writes it any more; it remains only because
  /// dropping it in the same migration that stops writing it would fail live
  /// scans for the length of the deploy. Remove in a follow-up.
  warehouse  Int?

  /// Which slot of the legacy row this event was expanded from —
  /// TIMECLOCKIN / TIMECLOCKOUT / SCANTIME / OUTTIME — or 'LIVE' for a scan
  /// posted by a kiosk in real time.
  ///
  /// Part of the idempotency key, and NOT NULL for that reason: Postgres treats
  /// NULLs in a unique index as distinct, so a nullable discriminator would stop
  /// live retries deduping at all.
  sourceSlot String  @default("LIVE")
  /// The legacy report row this was expanded from, for tracing a row back to
  /// its source. Null for live scans.
  sourceRef  String?

  /// The Punch this scan produced, when the timecard pipeline accepted it.
  /// Null whenever it did not — which is the interesting case.
  punchId String? @unique

  /* ---- What the timecard pipeline made of this scan ----
     Recorded for comparison, never used to decide `direction`. A row where
     these disagree with `direction`, or where they are absent entirely, is
     what detect-scan-discrepancies raises an Exception for. */

  outcome ScanOutcome @default(PENDING)
  /// The pipeline's own words when it refused the scan.
  rejectionReason String?
  /// CLOCK_IN or CLOCK_OUT: the pipeline's verdict reduced to the two punch
  /// types a tablet knows (see tablet-verdict.ts). Rows written before
  /// 2026-09-24 may still carry the pipeline's own MEAL_* / BREAK_* words.
  timecardPunchType String?
  /// WORK or OUT — whether the pipeline left the employee on the clock. That
  /// is what gets compared against this row's independently resolved
  /// `direction`. Null when the pipeline refused the scan.
  timecardStateAfter String?

  /// What the legacy cajaapi call reported, when it reported anything. Recorded
  /// for reconciliation only — never used to decide `direction`.
  legacyScanType String?
  /// True when `legacyScanType` was present and disagreed with `direction`.
  /// These are the rows to look at when the two systems drift apart.
  legacyMismatch Boolean @default(false)

  /// Why a scan carries UNKNOWN, or could not be matched to an employee.
  note String?

  createdAt DateTime @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id])
  punch    Punch?    @relation(fields: [punchId], references: [id])

  /// Makes a retried post idempotent — the kiosk queue retries the same scan
  /// until the server takes it, and a duplicate must not flip the direction.
  ///
  /// `sourceSlot` is in the key because a clock-out and the next clock-in do
  /// legitimately land in the same second: two months of production logs hold
  /// 393 such pairs, and without the discriminator the log kept one and
  /// silently dropped the other — which was always the opposite direction.
  /// Live retries are unaffected: both posts carry 'LIVE'.
  @@unique([badgeCode, stream, scanTime, sourceSlot])
  @@index([employeeId, stream, scanTime(sort: Desc)])
  @@index([tenantId, stream, scanTime(sort: Desc)])
  @@index([badgeCode, scanTime(sort: Desc)])
  /// Drives the discrepancy sweep, which looks for anything that is not a
  /// clean PUNCH_RECORDED within a date window.
  @@index([tenantId, outcome, scanTime(sort: Desc)])
  @@map("scan_events")
}

model WorkSegment {
  id              String      @id @default(cuid())
  timesheetId     String
  segmentType     SegmentType
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  segmentDate     DateTime    @db.Date
  isPaid          Boolean
  payBucket         PayBucket
  payBucketOverride PayBucket?
  isSplit           Boolean     @default(false)
  leaveRequestId    String?
  payCodeId         String?
  createdAt       DateTime    @default(now())

  timesheet    Timesheet     @relation(fields: [timesheetId], references: [id])
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
  payCode      PayCode?      @relation(fields: [payCodeId], references: [id])

  @@map("work_segments")
}

model MealWaiver {
  id          String   @id @default(cuid())
  timesheetId String
  segmentDate DateTime @db.Date
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  timesheet Timesheet @relation(fields: [timesheetId], references: [id])
  createdBy Employee? @relation(fields: [createdById], references: [id])

  @@unique([timesheetId, segmentDate])
  @@map("meal_waivers")
}

model Exception {
  id            String        @id @default(cuid())
  timesheetId   String
  exceptionType ExceptionType
  description   String
  occurredAt    DateTime
  resolvedAt    DateTime?
  resolvedById  String?
  resolution    String?
  createdAt     DateTime      @default(now())

  timesheet Timesheet @relation(fields: [timesheetId], references: [id])

  @@map("exceptions")
}

/// Lightweight per-day reason code annotation. Never touches work segments.
model TimesheetDayReason {
  timesheetId  String
  segmentDate  DateTime @db.Date
  reasonCodeId String

  timesheet  Timesheet  @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  reasonCode ReasonCode @relation(fields: [reasonCodeId], references: [id])

  @@id([timesheetId, segmentDate])
  @@map("timesheet_day_reasons")
}
