enum OtCycle {
  WEEKLY
  BIWEEKLY
  CUSTOM
}

enum AutoPayMode {
  POLICY_HOURS
  SHIFT_HOURS
}

enum HolidayCreditMethod {
  FIXED_HOURS
  ACTUAL_WORKED
  SCHEDULED_HOURS
}

model HolidayRule {
  id       String @id @default(cuid())
  tenantId String
  number   Int?
  name     String

  /// How holiday hours are credited to the employee
  creditMethod     HolidayCreditMethod @default(FIXED_HOURS)
  /// Minutes to credit when creditMethod = FIXED_HOURS (e.g. 480 = 8 h)
  creditMinutes    Int                 @default(480)
  /// Maximum minutes to credit per holiday (0 = no cap)
  maxCreditMinutes Int                 @default(0)
  /// PayBucket assigned to the credited time
  payBucket        PayBucket           @default(HOLIDAY)
  /// Multiplier × 100 for hours worked on the holiday (200 = 2.0×, 150 = 1.5×)
  workingPremium   Int                 @default(200)

  /// Specific pay code to post holiday hours to (overrides payBucket when set)
  payCodeId String?

  /// Include employees still in their probationary period
  includeOnProbation Boolean @default(false)
  /// How many days from hire date constitute the probationary period
  probationDays      Int     @default(90)

  /// Require employee to have been hired at least N days/months before the holiday
  tenureRequiredEnabled Boolean @default(false)
  tenureRequiredDays    Int     @default(90)
  tenureRequiredBasis   String  @default("HIRE_DATE")  /// HIRE_DATE | ADJUSTED_HIRE_DATE
  tenureRequiredUnit    String  @default("DAYS")        /// DAYS | MONTHS

  /// Only include employees currently assigned to and active with Daily/Weekly Averaging
  dailyWeeklyAveragingOnly Boolean @default(false)

  /// Employee must have worked the day before the holiday to qualify
  requireDayBefore       Boolean @default(false)
  /// Employee must have worked the day after the holiday to qualify
  requireDayAfter        Boolean @default(false)
  /// Employee must have worked the day before OR after (either satisfies)
  requireDayBeforeOrAfter Boolean @default(false)
  /// Minimum minutes worked in the pay period to qualify (0 = no minimum)
  minPeriodMinutes       Int     @default(0)

  /// Must work at least N days within a window before the holiday
  requireDaysWorkedEnabled      Boolean @default(false)
  requireDaysWorkedCount        Int     @default(0)
  requireDaysWorkedPeriod       Int     @default(0)
  requireDaysWorkedPeriodUnit   String  @default("DAY")   /// DAY | WEEK
  requireDaysWorkedMinDailyHours Decimal @default(0) @db.Decimal(5, 2)

  /// Must work at least N% of scheduled calculated hours on eligible workday(s)
  requireScheduledHoursPct      Boolean @default(false)
  requireScheduledHoursPctValue Int     @default(50)

  /// Employee must NOT have worked on the holiday to qualify
  mustNotWorkOnHoliday Boolean @default(false)

  /// When checking eligibility, use all dynamic schedules for the day (multiple in a day)
  useDynamicSchedules Boolean @default(false)

  /// Days of week (0=Sun … 6=Sat) excluded from eligibility rule counts
  excludedWeekDays Int[] @default([])

  /// Allow a "Post Holiday bypass" option for the scheduled workday after requirement
  bypassAfterEligibility Boolean @default(false)

  /// Only pay holiday credit if the employee did NOT work on the holiday
  payNonWorkingHolidayOnly Boolean @default(false)

  /// Post hours physically worked on the holiday to an accrual bank
  postWorkingHoursToAccrual     Boolean @default(false)
  postWorkingHoursMax           Decimal @default(0) @db.Decimal(5, 2)
  postWorkingHoursExcessEnabled Boolean @default(false)
  postWorkingHoursExcessMin     Decimal @default(0) @db.Decimal(5, 2)
  /// Accrual code identifier to post working hours into
  accrualCode                   String?

  /// Include non-calculated attendance pay codes when evaluating eligibility
  includeNonCalcAttendance Boolean @default(true)

  /// Whether credited hours count toward the weekly OT threshold
  countTowardOt Boolean @default(true)

  /// Prorate Rule — pay partial holiday credit based on recent worked-hours average
  prorateEnabled             Boolean @default(false)
  prorateLookbackDays        Int     @default(28)
  prorateIncludeCurrentWeek  Boolean @default(true)
  prorateUseCustomRange      Boolean @default(false)
  /// THRESHOLD | AVERAGE_DAILY
  prorateAppliedRule          String  @default("AVERAGE_DAILY")
  prorateThresholdHours       Decimal @default(0)   @db.Decimal(7, 3)
  prorateMultiplier            Decimal @default(0)   @db.Decimal(10, 7)
  prorateAverageDailyMaxHours  Decimal @default(8)   @db.Decimal(7, 3)
  prorateExcludeOt             Boolean @default(false)

  /// Employee birthdays are treated as a holiday under this rule
  birthdayIsHoliday       Boolean @default(false)
  /// Apply date-specific pay overrides for holidays in this rule
  holidayOverridesEnabled Boolean @default(false)
  /// JSON array of HolidayOverride objects { date, hours, payCodeId }
  holidayOverrides        Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant               @relation(fields: [tenantId], references: [id])
  employees        Employee[]
  assignedHolidays HolidayRuleHoliday[]

  @@unique([tenantId, name])
  @@map("holiday_rules")
}

model HolidayRuleHoliday {
  holidayRuleId String
  holidayId     String

  holidayRule HolidayRule @relation(fields: [holidayRuleId], references: [id], onDelete: Cascade)
  holiday     Holiday     @relation(fields: [holidayId],     references: [id], onDelete: Cascade)

  @@id([holidayRuleId, holidayId])
  @@map("holiday_rule_holidays")
}

model PayCategory {
  id                String   @id @default(cuid())
  tenantId          String
  number            Int
  description       String?
  isActive          Boolean  @default(true)
  limitLeaveTypes   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  employees           Employee[]
  ptoPolicies         PayCategoryPtoPolicy[]
  availableLeaveTypes PayCategoryLeaveType[]

  @@unique([tenantId, number])
  @@map("pay_categories")
}

model PayCategoryPtoPolicy {
  payCategoryId String
  ptoPolicyId   String

  payCategory PayCategory @relation(fields: [payCategoryId], references: [id], onDelete: Cascade)
  ptoPolicy   PtoPolicy   @relation(fields: [ptoPolicyId], references: [id], onDelete: Cascade)

  @@id([payCategoryId, ptoPolicyId])
  @@map("pay_category_pto_policies")
}

model PayCategoryLeaveType {
  payCategoryId String
  leaveTypeId   String

  payCategory PayCategory @relation(fields: [payCategoryId], references: [id], onDelete: Cascade)
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@id([payCategoryId, leaveTypeId])
  @@map("pay_category_leave_types")
}

model PayType {
  id                     String   @id @default(cuid())
  tenantId               String
  number                 Int
  description            String?
  includeInEmployeeSetup Boolean  @default(true)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, number])
  @@map("pay_types")
}

model RuleSet {
  id       String @id @default(cuid())
  tenantId String
  name     String
  number   Int?

  // Overtime rate multipliers (used at payroll export; 150 = 1.5×, 200 = 2.0×)
  otRateMultiplier         Int     @default(150)   // OT-1 rate × 100
  dtRateMultiplier         Int     @default(200)   // OT-2 (DT) rate × 100

  // Overtime authorization
  overtimeRequiresAuth     Boolean @default(false) // OT must be authorized before payroll
  allowTimesheetOtAuth     Boolean @default(true)  // supervisors can authorize at timecard level
  otGraceBeforeShiftMinutes Int    @default(0)     // OT within this window before shift start → REG
  otGraceAfterShiftMinutes  Int    @default(0)     // OT within this window after shift end → REG

  // Overtime thresholds
  dailyOtMinutes           Int     @default(480)   // 8 hours; ≥1440 = disabled
  dailyDtMinutes           Int     @default(720)   // 12 hours cumulative; ≥1440 = disabled
  dailyDtMaxMinutes        Int     @default(0)     // 0 = no cap on daily DT
  weeklyOtEnabled          Boolean @default(true)
  weeklyOtMinutes          Int     @default(2400)  // 40 hours per OT cycle window
  weeklyDtMinutes          Int     @default(86400) // ≥86400 = disabled
  weeklyDtMaxMinutes       Int     @default(0)     // 0 = no cap on weekly DT
  consecutiveDayOtEnabled      Boolean @default(false)
  consecutiveDayOtDay          Int     @default(7)
  consecutiveDayPayCycleOnly   Boolean @default(true)   // true = all 7 days must be in one pay cycle
  consecutiveDayOtMaxMinutes   Int     @default(0)      // 0 = no cap on consecutive day OT
  consecutiveDayDtMaxMinutes   Int     @default(0)      // 0 = no cap on consecutive day DT

  // Punch rounding — general In/Out rounding (applied after shift-aware rounding windows)
  punchRoundingInEnabled       Boolean @default(false)
  punchRoundingInMinutes       Int     @default(15)  // rounding interval in minutes
  punchRoundingInPoint         Int     @default(0)   // offset that shifts the rounding grid
  punchRoundingInApplyToBreaks Boolean @default(false)
  punchRoundingOutEnabled       Boolean @default(false)
  punchRoundingOutMinutes       Int     @default(15)
  punchRoundingOutPoint         Int     @default(0)
  punchRoundingOutApplyToBreaks Boolean @default(false)

  // In/Out Pair rounding — rounds the total work duration per day after meal deductions
  pairRoundingEnabled       Boolean @default(false)
  pairRoundingMinutes       Int     @default(15) // rounding interval applied to total daily work minutes
  pairRoundingPoint         Int     @default(0)  // offset that shifts the rounding grid
  pairMinGuaranteedMinutes  Int     @default(0)  // minimum credited minutes per punch pair (0 = no minimum)

  // Shift-aware rounding (Novatime A/B/C/D windows)
  shiftRoundingEnabled     Boolean @default(false) // master toggle for shift-aware rounding
  shiftRoundingInWindow    Int     @default(0)    // A: minutes before shift start → snap to start
  shiftRoundingInGrace     Int     @default(0)    // B: minutes after shift start → snap to start
  shiftRoundingOutGrace    Int     @default(0)    // C: minutes before shift end → snap to end
  shiftRoundingOutWindow   Int     @default(0)    // D: minutes after shift end → snap to end

  // Meal rules
  mealBreakMinutes        Int     @default(30)  // unpaid meal duration
  mealBreakAfterMinutes   Int     @default(300) // trigger meal after 5h work
  autoDeductMeal          Boolean @default(false)

  // Short break rules (paid)
  shortBreakMinutes       Int @default(15)
  shortBreaksPerDay       Int @default(2)

  // Exception thresholds
  longShiftMinutes        Int @default(720) // flag if shift > 12h

  // Pay period configuration (optional — falls back to tenant settings when null)
  payFrequency        PayFrequency? // null = use tenant-level setting
  payPeriodAnchorDate DateTime?     // null = use tenant-level setting

  // Workweek definition (0=Sun, 1=Mon … 6=Sat) — controls weekly OT boundary
  weekStartDay        Int           @default(1)

  // Overtime accumulation cycle (defaults to WEEKLY when null)
  otCycle             OtCycle?
  otCycleDays         Int?          // used when otCycle = CUSTOM
  otCycleAnchorDate   DateTime?     // reference date for BIWEEKLY / CUSTOM window alignment

  // Default pay code applied to new timecard rows and salary daily credits
  defaultPayCodeId    String?

  // Guaranteed Hours / Auto-Pay — credit hours automatically without punch activity
  autoPayEnabled                  Boolean     @default(false)
  autoPayMode                     AutoPayMode @default(POLICY_HOURS)
  /// JSON array of 7 AutoPayDayRow objects (Sun–Sat): { day: 0-6, apply: bool, minutes: int }
  autoPayDaySchedule              Json?       // used when autoPayMode = POLICY_HOURS; SHIFT_HOURS uses shift duration
  autoPayPayCodeId                String?     // pay code for auto-credits; null = fall back to defaultPayCodeId
  autoPayOverflowThresholdMinutes Int         @default(0)     // 0 = disabled; credits above this total → overflowPayCode
  autoPayOverflowPayCodeId        String?     // pay code for overflow credits when threshold is exceeded

  // Meal / Break Premium Rules
  mealBreakPremiumEnabled         Boolean     @default(false) // apply premium when employee misses required meal/break
  mealBreakPremiumMaxPerDay       Int         @default(2)     // max premium credits per day
  mealBreakPremiumResetEnabled    Boolean     @default(false) // reset calculation when punched out > threshold
  mealBreakPremiumResetMinutes    Int         @default(0)     // minutes without a punch-in before reset (0 = disabled)
  mealBreakPremiumWaivedMsgEnabled Boolean    @default(false) // show waived-meal message to employee
  mealBreakPremiumWaivedMsg       String?     // message shown when premium is waived (max 250 chars)

  // Meal Premium — calculation options
  mealPremiumUseActualForWindow   Boolean     @default(true)  // use non-rounded times for "no meal between" window check
  mealPremiumUseActualForMinimum  Boolean     @default(true)  // use non-rounded times for minimum meal duration check
  mealPremiumLimitToPayMinutes    Boolean     @default(false) // limit paid premium to (payMinutes − actual meal taken)
  mealPremiumAllowTimesheetEdits  Boolean     @default(true)  // allow supervisors to edit premium records on timecard
  mealPremiumUseTransferGroup     Boolean     @default(false) // copy transfer group (job/dept) onto premium records
  /// JSON array of up to 4 MealPremiumRow objects — see rule-sets-manager.tsx MealPremiumRow interface
  mealPremiumRows                 Json?

  // FLSA Policy Setup
  flsaEnabled                  Boolean @default(false)
  flsaType                     String  @default("FEDERAL")           // "FEDERAL" | "CALIFORNIA"
  flsaDistributionFrequency    String  @default("PER_PERIOD")        // "PER_PERIOD" | "WEEKLY"
  flsaAdjustmentPayCodeId      String?
  flsaAdjustmentInRefTime      String?
  flsaAltPayCodeEnabled        Boolean @default(false)
  flsaAltPayCodeId             String?
  flsaAltInRefTime             String?
  flsaIncludePremiumHours      Boolean @default(false)
  flsaIncludePayMatrixHours    Boolean @default(false)
  flsaNoNegativeAdjustment     Boolean @default(false)
  flsaUseTotalOtPremium        Boolean @default(false)
  flsaWeeklyOtPayMethod        Boolean @default(false)
  flsaMaxWeeklyRegularMinutes  Int     @default(2400)
  flsaWeeklyOtLevel            String  @default("OT1")              // "OT1" | "OT2"
  flsaApplyFullOtAmount        Boolean @default(false)
  flsaDistributeMultipleRecords Boolean @default(false)
  flsaOtRateComputation        String  @default("BASE_PLUS_AVG_HALF") // "BASE_PLUS_AVG_HALF" | "AVG_RATE" | "BASE_RATE"
  flsaOtLevels                 Json?   // string[] — e.g. ["OT1", "OT2"]
  flsaIncludeAsRegular         Json?   // string[] — e.g. ["OT1"]

  // Workday Expansion — defines the window around the scheduled shift during which
  // punches are associated with that workday (mirrors Novatime's Expansion settings).
  workdayExpansionEnabled       Boolean @default(false) // Apply workday expansion?
  workdayExpansionUseShiftDef   Boolean @default(true)  // true = use shift definition; false = do not use workday definition
  workdayExpansionBeforeMinutes Int     @default(0)     // minutes before shift start included in this workday
  workdayExpansionAfterMinutes  Int     @default(120)   // minutes after shift end included in this workday

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  employees      Employee[]
  payPeriods     PayPeriod[]
  defaultPayCode PayCode?    @relation(fields: [defaultPayCodeId], references: [id])

  @@unique([tenantId, name])
  @@map("rule_sets")
}
