enum OtCycle {
  WEEKLY
  BIWEEKLY
  CUSTOM
}

enum HolidayCreditMethod {
  FIXED_HOURS
  ACTUAL_WORKED
  SCHEDULED_HOURS
}

model HolidayRule {
  id       String @id @default(cuid())
  tenantId String
  number   Int?
  name     String

  /// How holiday hours are credited to the employee
  creditMethod     HolidayCreditMethod @default(FIXED_HOURS)
  /// Minutes to credit when creditMethod = FIXED_HOURS (e.g. 480 = 8 h)
  creditMinutes    Int                 @default(480)
  /// Maximum minutes to credit per holiday (0 = no cap)
  maxCreditMinutes Int                 @default(0)
  /// PayBucket assigned to the credited time
  payBucket        PayBucket           @default(HOLIDAY)
  /// Multiplier × 100 for hours worked on the holiday (200 = 2.0×, 150 = 1.5×)
  workingPremium   Int                 @default(200)

  /// Employee must have worked the day before the holiday to qualify
  requireDayBefore Boolean @default(false)
  /// Employee must have worked the day after the holiday to qualify
  requireDayAfter  Boolean @default(false)
  /// Minimum minutes worked in the pay period to qualify (0 = no minimum)
  minPeriodMinutes Int     @default(0)

  /// Whether credited hours count toward the weekly OT threshold
  countTowardOt Boolean @default(true)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]

  @@unique([tenantId, name])
  @@map("holiday_rules")
}

model PayCategory {
  id                String   @id @default(cuid())
  tenantId          String
  number            Int
  description       String?
  isActive          Boolean  @default(true)
  limitLeaveTypes   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  employees           Employee[]
  ptoPolicies         PayCategoryPtoPolicy[]
  availableLeaveTypes PayCategoryLeaveType[]

  @@unique([tenantId, number])
  @@map("pay_categories")
}

model PayCategoryPtoPolicy {
  payCategoryId String
  ptoPolicyId   String

  payCategory PayCategory @relation(fields: [payCategoryId], references: [id], onDelete: Cascade)
  ptoPolicy   PtoPolicy   @relation(fields: [ptoPolicyId], references: [id], onDelete: Cascade)

  @@id([payCategoryId, ptoPolicyId])
  @@map("pay_category_pto_policies")
}

model PayCategoryLeaveType {
  payCategoryId String
  leaveTypeId   String

  payCategory PayCategory @relation(fields: [payCategoryId], references: [id], onDelete: Cascade)
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@id([payCategoryId, leaveTypeId])
  @@map("pay_category_leave_types")
}

model RuleSet {
  id       String @id @default(cuid())
  tenantId String
  name     String

  // Overtime rate multipliers (used at payroll export; 150 = 1.5×, 200 = 2.0×)
  otRateMultiplier         Int     @default(150)   // OT-1 rate × 100
  dtRateMultiplier         Int     @default(200)   // OT-2 (DT) rate × 100

  // Overtime authorization
  overtimeRequiresAuth     Boolean @default(false) // OT must be authorized before payroll
  allowTimesheetOtAuth     Boolean @default(true)  // supervisors can authorize at timecard level
  otGraceBeforeShiftMinutes Int    @default(0)     // OT within this window before shift start → REG
  otGraceAfterShiftMinutes  Int    @default(0)     // OT within this window after shift end → REG

  // Overtime thresholds
  dailyOtMinutes           Int     @default(480)   // 8 hours; ≥1440 = disabled
  dailyDtMinutes           Int     @default(720)   // 12 hours cumulative; ≥1440 = disabled
  dailyDtMaxMinutes        Int     @default(0)     // 0 = no cap on daily DT
  weeklyOtEnabled          Boolean @default(true)
  weeklyOtMinutes          Int     @default(2400)  // 40 hours per OT cycle window
  weeklyDtMinutes          Int     @default(86400) // ≥86400 = disabled
  weeklyDtMaxMinutes       Int     @default(0)     // 0 = no cap on weekly DT
  consecutiveDayOtEnabled      Boolean @default(false)
  consecutiveDayOtDay          Int     @default(7)
  consecutiveDayPayCycleOnly   Boolean @default(true)   // true = all 7 days must be in one pay cycle
  consecutiveDayOtMaxMinutes   Int     @default(0)      // 0 = no cap on consecutive day OT
  consecutiveDayDtMaxMinutes   Int     @default(0)      // 0 = no cap on consecutive day DT

  // Punch rounding (minutes, 0 = no rounding)
  punchRoundingMinutes Int @default(0)

  // Meal rules
  mealBreakMinutes        Int     @default(30)  // unpaid meal duration
  mealBreakAfterMinutes   Int     @default(300) // trigger meal after 5h work
  autoDeductMeal          Boolean @default(false)

  // Short break rules (paid)
  shortBreakMinutes       Int @default(15)
  shortBreaksPerDay       Int @default(2)

  // Exception thresholds
  longShiftMinutes        Int @default(720) // flag if shift > 12h

  // Pay period configuration (optional — falls back to tenant settings when null)
  payFrequency        PayFrequency? // null = use tenant-level setting
  payPeriodAnchorDate DateTime?     // null = use tenant-level setting

  // Workweek definition (0=Sun, 1=Mon … 6=Sat) — controls weekly OT boundary
  weekStartDay        Int           @default(1)

  // Overtime accumulation cycle (defaults to WEEKLY when null)
  otCycle             OtCycle?
  otCycleDays         Int?          // used when otCycle = CUSTOM
  otCycleAnchorDate   DateTime?     // reference date for BIWEEKLY / CUSTOM window alignment

  // Default pay code applied to new timecard rows and salary daily credits
  defaultPayCodeId    String?

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  employees      Employee[]
  payPeriods     PayPeriod[]
  defaultPayCode PayCode?    @relation(fields: [defaultPayCodeId], references: [id])

  @@unique([tenantId, name])
  @@map("rule_sets")
}
