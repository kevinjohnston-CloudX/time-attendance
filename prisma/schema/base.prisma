generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  SUPERVISOR
  PAYROLL_ADMIN
  HR_ADMIN
  SYSTEM_ADMIN
  SUPER_ADMIN
}

enum PunchType {
  CLOCK_IN
  CLOCK_OUT
  MEAL_START
  MEAL_END
  BREAK_START
  BREAK_END
}

enum PunchState {
  OUT
  WORK
  MEAL
  BREAK
}

enum PunchSource {
  WEB
  KIOSK
  MOBILE
  MANUAL
  SYSTEM
}

/// Which kiosk flow a badge scan came from. The two are independent states:
/// someone can be present in the building (SECURITY = IN) while clocked out
/// for a meal (TIME_CLOCK = OUT), so they are never collapsed into one flag.
enum ScanStream {
  TIME_CLOCK
  SECURITY
}

/// Which way a scan went. UNKNOWN is a real, storable answer — it is what an
/// unmatched badge or an unresolvable scan gets, rather than a guessed IN.
enum ScanDirection {
  IN
  OUT
  UNKNOWN
}

/// What the timecard pipeline did with a scan, recorded on the scan itself.
///
/// The point of this field is that a scan is written down BEFORE the pipeline
/// runs, so a scan the pipeline refused — or crashed on — still leaves a row.
/// Those are precisely the scans that are worth alerting on, and the previous
/// design lost every one of them.
enum ScanOutcome {
  /// Written, pipeline has not reported back yet. A row left in this state is
  /// itself a fault: something died between recording and resolving.
  PENDING
  /// A punch was created. `punchId` points at it.
  PUNCH_RECORDED
  /// The pipeline understood the scan and refused it — no open pay period, a
  /// locked timesheet, an invalid state transition, an inactive employee.
  PUNCH_REJECTED
  /// No employee matches this badge. Nothing could be recorded against anyone.
  NO_EMPLOYEE
  /// The pipeline threw. The scan happened; what followed did not.
  ERROR
  /// Security gate scans, which never enter the timecard pipeline at all.
  NOT_APPLICABLE
}

