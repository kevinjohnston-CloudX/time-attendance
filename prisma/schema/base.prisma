generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  SUPERVISOR
  PAYROLL_ADMIN
  HR_ADMIN
  SYSTEM_ADMIN
  SUPER_ADMIN
}

enum PunchType {
  CLOCK_IN
  CLOCK_OUT
  MEAL_START
  MEAL_END
  BREAK_START
  BREAK_END
}

enum PunchState {
  OUT
  WORK
  MEAL
  BREAK
}

enum PunchSource {
  WEB
  KIOSK
  MOBILE
  MANUAL
  SYSTEM
}

/// Which kiosk flow a badge scan came from. The two are independent states:
/// someone can be present in the building (SECURITY = IN) while clocked out
/// for a meal (TIME_CLOCK = OUT), so they are never collapsed into one flag.
enum ScanStream {
  TIME_CLOCK
  SECURITY
}

/// Which way a scan went. UNKNOWN is a real, storable answer — it is what an
/// unmatched badge or an unresolvable scan gets, rather than a guessed IN.
enum ScanDirection {
  IN
  OUT
  UNKNOWN
}

/// What the timecard pipeline did with a scan, recorded on the scan itself.
///
/// The point of this field is that a scan is written down BEFORE the pipeline
/// runs, so a scan the pipeline refused — or crashed on — still leaves a row.
/// Those are precisely the scans that are worth alerting on, and the previous
/// design lost every one of them.
enum ScanOutcome {
  /// Written, pipeline has not reported back yet. A row left in this state is
  /// itself a fault: something died between recording and resolving.
  PENDING
  /// A punch was created. `punchId` points at it.
  PUNCH_RECORDED
  /// The pipeline understood the scan and refused it — no open pay period, a
  /// locked timesheet, an invalid state transition, an inactive employee.
  PUNCH_REJECTED
  /// No employee matches this badge. Nothing could be recorded against anyone.
  NO_EMPLOYEE
  /// The pipeline threw. The scan happened; what followed did not.
  ERROR
  /// Security gate scans, which never enter the timecard pipeline at all.
  NOT_APPLICABLE
}

enum SegmentType {
  WORK
  MEAL
  BREAK
  LEAVE
  HOLIDAY
}

enum TimesheetStatus {
  OPEN
  SUBMITTED
  SUP_APPROVED
  PAYROLL_APPROVED
  LOCKED
}

enum PayPeriodStatus {
  OPEN
  READY
  LOCKED
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
  POSTED
}

enum LeaveCategory {
  PTO
  SICK
  HOLIDAY
  FMLA
  BEREAVEMENT
  JURY_DUTY
  MILITARY
  UNPAID
}

enum PayBucket {
  REG
  OT
  DT
  PTO
  SICK
  HOLIDAY
  FMLA
  BEREAVEMENT
  JURY_DUTY
  MILITARY
  UNPAID
}

enum AccrualAction {
  ACCRUAL
  EARNED_ADJUSTMENT
  USAGE
  ADJUSTMENT
  CARRY_OVER
  FORFEITURE
  BALANCE_RESET
  EOD_SNAPSHOT
  POLICY_CHANGE
  TIMECARD_DEDUCTION
}

enum ExceptionType {
  MISSING_PUNCH
  LONG_SHIFT
  SHORT_BREAK
  MISSED_MEAL
  UNSCHEDULED_OT
  CONSECUTIVE_DAYS
  ABSENT
  LATE_IN
  EARLY_OUT
  /// A tablet recorded a scan that the timecard does not account for, or
  /// accounts for differently. Raised by detect-scan-discrepancies, which
  /// compares the tablet transaction log against the punches themselves —
  /// the one exception type not derived from punches, and so the only one
  /// that can see a punch which is simply absent.
  SCAN_DISCREPANCY
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
}

enum AuditEntityType {
  USER
  EMPLOYEE
  PUNCH
  TIMESHEET
  PAY_PERIOD
  LEAVE_REQUEST
  LEAVE_BALANCE
  RULE_SET
  DOCUMENT
  ADP_SYNC
  REPORT
  ROLE
  PTO_POLICY
}
