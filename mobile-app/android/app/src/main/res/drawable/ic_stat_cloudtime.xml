<?xml version="1.0" encoding="utf-8"?>
<!-- Notification icon: the CloudTime dial (src/app/icon.svg) as a one-colour
     silhouette. Android draws status bar and notification icons from the alpha
     channel only, so the full-colour app icon showed as a plain circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:pathData="M50,12 a38,38 0 1,1 0,76 a38,38 0 1,1 0,-76 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="10" />
    <path
        android:pathData="M50,50 V26 M50,50 H72"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round" />
</vector>
